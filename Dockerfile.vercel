# Vercel container image: the Python API, the built app, and the terrain and SPICE files baked in.
# Vercel builds it on every push (production from main). Data files are downloaded from PDS and NAIF during
# the build and checked byte for byte. The 10 m polar terrain is stored as six row pieces, one image layer each,
# because Vercel's registry limits a compressed layer to 500 MB.
FROM node:22-slim AS studio
RUN npm install --global pnpm@10.33.0
WORKDIR /build
COPY apps/clps/studio/package.json apps/clps/studio/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/clps/studio ./
RUN pnpm build

FROM python:3.12-slim AS assets
COPY deploy/vercel/fetch_assets.py deploy/vercel/asset-receipts.json deploy/vercel/extra-assets.json /tmp/
RUN python /tmp/fetch_assets.py /data/assets /tmp/asset-receipts.json /tmp/extra-assets.json \
 && cp /tmp/asset-receipts.json /data/asset-receipts.json

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLCONFIGDIR=/tmp/lml-matplotlib PORT=8765
WORKDIR /srv/lml
COPY --from=assets /data/assets/ldem_85s_10m.img.part000 /data/assets/
COPY --from=assets /data/assets/ldem_85s_10m.img.part001 /data/assets/
COPY --from=assets /data/assets/ldem_85s_10m.img.part002 /data/assets/
COPY --from=assets /data/assets/ldem_85s_10m.img.part003 /data/assets/
COPY --from=assets /data/assets/ldem_85s_10m.img.part004 /data/assets/
COPY --from=assets /data/assets/ldem_85s_10m.img.part005 /data/assets/
COPY --from=assets /data/assets/ldem_85s_40m.img /data/assets/
COPY --from=assets /data/asset-receipts.json /data/
COPY --from=assets /data/assets/*.lbl /data/assets/*.bsp /data/assets/*.bpc /data/assets/*.tls /data/assets/*.tpc /data/assets/*.tf /data/assets/ldem_16.img /data/assets/
RUN mkdir -p /data/live-estimates && chown 10001:10001 /data /data/live-estimates
COPY apps/clps/api/pyproject.toml /srv/lml/apps/clps/api/pyproject.toml
COPY apps/clps/api/src /srv/lml/apps/clps/api/src
RUN pip install --no-cache-dir ./apps/clps/api
COPY data/manifests/clps /srv/lml/data/manifests/clps
COPY --from=studio /build/dist /srv/lml/apps/clps/studio/dist
ENV PYTHONPATH=/srv/lml/apps/clps/api/src
USER 10001:10001
EXPOSE 8765
CMD ["python","-m","lunar_lab.planner_server","--host","0.0.0.0","--public","--work-dir","/data"]
